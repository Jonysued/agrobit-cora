{
  "name": "Sync Sondas Sentek",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */3 * * *",
      "one_time_date": null,
      "timezone": "America/Buenos_Aires",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Sincroniza autom\u00e1ticamente cada 3 horas todas las sondas Sentek (IrriMAX Live) activas con lote vinculado.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_sondas_sentek",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_probes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncAllSentekProbes",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar sondas Sentek",
            "description": "Todas las sondas vinculadas"
          }
        }
      }
    ]
  }
}