{
  "name": "WeatherStation",
  "type": "object",
  "properties": {
    "farm_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "davis",
        "wiseconn",
        "pessl",
        "campbell",
        "metos",
        "generic_api",
        "webhook",
        "manual"
      ]
    },
    "external_station_id": {
      "type": "string"
    },
    "connection_type": {
      "type": "string",
      "enum": [
        "api",
        "webhook",
        "manual"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_data_at": {
      "type": "string",
      "format": "date-time"
    },
    "connection_status": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "elevation_m": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "farm_id",
    "name",
    "provider"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}