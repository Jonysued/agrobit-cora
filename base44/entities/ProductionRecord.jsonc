{
  "name": "ProductionRecord",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string"
    },
    "campaign": {
      "type": "string"
    },
    "total_kg": {
      "type": "number"
    },
    "kg_ha": {
      "type": "number"
    },
    "kg_plant": {
      "type": "number"
    },
    "harvest_start": {
      "type": "string",
      "format": "date"
    },
    "harvest_end": {
      "type": "string",
      "format": "date"
    },
    "commercial_quality": {
      "type": "string"
    },
    "category_1_pct": {
      "type": "number"
    },
    "category_2_pct": {
      "type": "number"
    },
    "discard_pct": {
      "type": "number"
    },
    "average_caliber": {
      "type": "number"
    },
    "average_brix": {
      "type": "number"
    },
    "estimated": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "lot_id",
    "campaign",
    "total_kg",
    "kg_ha",
    "kg_plant"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}