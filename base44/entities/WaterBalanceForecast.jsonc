{
  "name": "WaterBalanceForecast",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string"
    },
    "forecast_date": {
      "type": "string",
      "format": "date"
    },
    "current_vwc": {
      "type": "number"
    },
    "forecast_vwc": {
      "type": "number"
    },
    "water_available_percent": {
      "type": "number"
    },
    "eto_mm": {
      "type": "number"
    },
    "etc_mm": {
      "type": "number"
    },
    "rainfall_mm": {
      "type": "number"
    },
    "effective_rainfall_mm": {
      "type": "number"
    },
    "irrigation_mm": {
      "type": "number"
    },
    "drainage_mm": {
      "type": "number"
    },
    "forecast_type": {
      "type": "string",
      "enum": [
        "no_irrigation",
        "recommended_irrigation"
      ]
    }
  },
  "required": [
    "lot_id",
    "forecast_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}