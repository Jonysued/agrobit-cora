{
  "name": "Observation",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string"
    },
    "campaign": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "user_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Producci\u00f3n",
        "Sanidad",
        "Riego",
        "Infraestructura",
        "Plantaci\u00f3n",
        "General"
      ]
    },
    "comment": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    }
  },
  "required": [
    "lot_id",
    "date",
    "category",
    "comment"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}