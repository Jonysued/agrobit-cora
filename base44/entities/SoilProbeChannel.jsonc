{
  "name": "SoilProbeChannel",
  "type": "object",
  "properties": {
    "probe_id": {
      "type": "string"
    },
    "external_channel_id": {
      "type": "string"
    },
    "sensor_type": {
      "type": "string"
    },
    "depth_cm": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "channel_order": {
      "type": "number"
    }
  },
  "required": [
    "probe_id",
    "depth_cm"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}