{
  "name": "IrrigationProgram",
  "type": "object",
  "properties": {
    "lot_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "well": {
      "type": "string"
    },
    "turno": {
      "type": "string"
    },
    "duration_min": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Programado",
        "Activo",
        "Pausado",
        "Finalizado"
      ],
      "default": "Programado"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "start_time"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}