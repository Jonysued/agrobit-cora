{
  "name": "SoilBehaviorModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "reference_probe_id": {
      "type": "string"
    },
    "depletion_rate_mm_day": {
      "type": "number"
    },
    "recharge_efficiency": {
      "type": "number"
    },
    "irrigation_response_delay_hours": {
      "type": "number"
    },
    "drainage_rate": {
      "type": "number"
    },
    "sample_count": {
      "type": "number"
    },
    "calibration_status": {
      "type": "string",
      "enum": [
        "uncalibrated",
        "partial",
        "calibrated",
        "sin_datos",
        "sin_sonda"
      ]
    },
    "last_calibration_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "reference_probe_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}