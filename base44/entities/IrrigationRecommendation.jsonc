{
  "name": "IrrigationRecommendation",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "recommended_irrigation_mm": {
      "type": "number"
    },
    "recommended_irrigation_m3": {
      "type": "number"
    },
    "recommended_start_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_irrigation_hours": {
      "type": "number"
    },
    "estimated_energy_kwh": {
      "type": "number"
    },
    "estimated_energy_cost": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "activa",
        "aplicada",
        "descartada"
      ],
      "default": "activa"
    }
  },
  "required": [
    "lot_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}