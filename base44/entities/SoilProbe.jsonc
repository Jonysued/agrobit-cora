{
  "name": "SoilProbe",
  "type": "object",
  "properties": {
    "monitoring_point_id": {
      "type": "string"
    },
    "farm_id": {
      "type": "string"
    },
    "lot_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "external_device_id": {
      "type": "string"
    },
    "installation_depth_cm": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "connection_status": {
      "type": "string"
    },
    "last_reading_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}