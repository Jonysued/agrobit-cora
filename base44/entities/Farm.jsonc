{
  "name": "Farm",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "weather_source": {
      "type": "string",
      "enum": [
        "FORECAST_ONLY",
        "WEATHER_STATION",
        "HYBRID"
      ],
      "default": "FORECAST_ONLY"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}