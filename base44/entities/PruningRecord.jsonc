{
  "name": "PruningRecord",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string"
    },
    "campaign": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string"
    },
    "intensity": {
      "type": "string",
      "enum": [
        "Leve",
        "Media",
        "Fuerte"
      ]
    },
    "objective": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "lot_id",
    "campaign",
    "date",
    "type",
    "intensity"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}