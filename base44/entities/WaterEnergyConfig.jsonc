{
  "name": "WaterEnergyConfig",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string"
    },
    "useful_water_mm": {
      "type": "number",
      "default": 120
    },
    "threshold_mm": {
      "type": "number",
      "default": 60
    },
    "etc_mm_day": {
      "type": "number"
    },
    "pump_flow_m3h": {
      "type": "number",
      "default": 40
    },
    "pump_power_kw": {
      "type": "number",
      "default": 15
    },
    "energy_price": {
      "type": "number",
      "default": 120
    }
  },
  "required": [
    "lot_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}