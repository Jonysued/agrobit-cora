{
  "name": "WeatherForecast",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "temperature_min_c": {
      "type": "number"
    },
    "temperature_max_c": {
      "type": "number"
    },
    "rainfall_mm": {
      "type": "number"
    },
    "effective_rainfall_mm": {
      "type": "number"
    },
    "eto_mm": {
      "type": "number"
    },
    "kc": {
      "type": "number"
    },
    "etc_mm": {
      "type": "number"
    }
  },
  "required": [
    "lot_id",
    "date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}